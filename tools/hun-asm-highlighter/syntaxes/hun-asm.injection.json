{
  "scopeName": "markdown.hun-asm.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "begin": "(^|\\G)(\\s*)(```)\\s*(hun-asm|asm|assembly)\\s*$",
      "end": "(^|\\G)(\\2)(```)\\s*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "contentName": "meta.embedded.block.hun-asm",
      "patterns": [
        { "include": "source.hun-asm" }
      ]
    }
  ]
}